
NODE_ENV=production
# PORT=3000

# Ajusta el host a un subdominio que apunte por DNS al VPS.
CLAB_API_HOST=clabback.unyxsolutions.com

# Confirma en el VPS el nombre exacto de la red compartida de Traefik.
TRAEFIK_NETWORK=unyx-workspace-front

POSTGRES_USER=clab
POSTGRES_DB=clab_carpool
POSTGRES_PASSWORD=GENERATE_ON_SERVER

JWT_SECRET=GENERATE_ON_SERVER
JWT_REFRESH_SECRET=GENERATE_ON_SERVER
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

EMAIL_VERIFICATION_CODE_EXPIRES_IN=10m

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@clab.app

# Actualiza estos valores cuando tengas el dominio del frontend.
APP_URL=https://clabback.unyxsolutions.com
FRONTEND_URL=https://example.com
CORS_ORIGIN=https://example.com

RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_VERIFY_WINDOW_MS=900000
RATE_LIMIT_VERIFY_MAX=3

BCRYPT_SALT_ROUNDS=12
