NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clab_carpool?schema=public

JWT_SECRET=change_this_jwt_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

EMAIL_VERIFICATION_CODE_EXPIRES_IN=10m

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@clab.app

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_VERIFY_WINDOW_MS=900000
RATE_LIMIT_VERIFY_MAX=3

BCRYPT_SALT_ROUNDS=12
